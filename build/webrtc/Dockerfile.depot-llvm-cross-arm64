FROM debian:bookworm-slim

ARG LLVM_VERSION=18
ENV DEBIAN_FRONTEND=noninteractive

# Install core tools and dependencies
RUN apt-get update && apt-get install -y \
    build-essential curl git file python-is-python3 python3 python3-pip \
    python3-venv pkg-config ninja-build sudo libx11-dev libpulse-dev ca-certificates lsb-release
    # build-dependencies witll install mor etools later, so don't remove the repo lists
    # && rm -rf /var/lib/apt/lists/*

# Install a selected LLVM compiler version fitting to build runtime arch
RUN cat <<EOS > /etc/apt/sources.list.d/llvm.list \
deb http://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-${LLVM_VERSION} main \
deb-src http://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-${LLVM_VERSION} main \
EOS && \
    apt-get install clang-format clang-tidy clang-tools clang clangd libc++-dev libc++1 \
            libc++abi-dev libc++abi1 libclang-dev libclang1 liblldb-dev libllvm-ocaml-dev \
            libomp-dev libomp5 lld lldb llvm-dev llvm-runtime llvm python3-clang &&
    debootstrap --arch=arm64 --variant=minbase --include=build-essential,symlinks stable sysroot-deb-arm64-stable \

ENV PATH="/opt/depot_tools:$PATH"
ENV DEPOT_TOOLS_UPDATE=0

# Install depot_tools
RUN git clone --depth=1 https://chromium.googlesource.com/chromium/tools/depot_tools.git /opt/depot_tools